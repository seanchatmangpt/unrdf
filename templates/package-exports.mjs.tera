/**
 * GENERATED by ggen v26.8.12 from the admitted package observation graph.
 * DO NOT EDIT: package.json manifests are observations; this file is a projection.
 */
export const PACKAGE_GRAPH_SCHEMA = 'urn:unrdf:package-projection:v3';

export const ALL_PACKAGES = [
{% for row in results %}  {
    name: "{{ row.name }}",
    version: "{{ row.version }}",
    path: "{{ row.path }}",
    tier: "{{ row.tier }}",
    private: {{ row.private }},
    entry: "{{ row.entry }}",
    manifestDigest: "{{ row.manifest_digest }}",
    dependencies: {{ row.dependencies_json }},
    reverseDependencies: {{ row.reverse_dependencies_json }},
    dependencyCount: {{ row.dependency_count }},
    reverseDependencyCount: {{ row.reverse_dependency_count }},
    sccId: "{{ row.scc_id }}",
    sccSize: {{ row.scc_size }},
    cyclic: {{ row.cyclic }},
    gates: { lint: {{ row.has_lint }}, build: {{ row.has_build }}, test: {{ row.has_test }} },
  },
{% endfor %}];

export const ESSENTIAL_PACKAGES = ALL_PACKAGES.filter(pkg => pkg.tier === 'Essential');
export const EXTENDED_PACKAGES = ALL_PACKAGES.filter(pkg => pkg.tier === 'Extended');
export const OPTIONAL_PACKAGES = ALL_PACKAGES.filter(pkg => pkg.tier === 'Optional');
export const INTERNAL_PACKAGES = ALL_PACKAGES.filter(pkg => pkg.tier === 'Internal');

export function getPackagesByTier(tier) {
  const normalized = String(tier || '').toLowerCase();
  return ALL_PACKAGES.filter(pkg => pkg.tier.toLowerCase() === normalized);
}

export function findPackage(name) {
  return ALL_PACKAGES.find(pkg => pkg.name === name);
}
