{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact Git Swarm Subject",
  "type": "object",
  "required": [
    "repository",
    "branch",
    "commit",
    "task",
    "tool"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
