@prefix sw: <https://unrdf.dev/ns/git-swarm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
sw:branchContract a sw:AdmissionContract ; sw:dimension "branch" ; sw:law "Branch identity binds repository plus exact ref name and observed head SHA." ; sw:requiredField "branch" ; sw:failureCode "branch_head_drift" .
